+                    </div>
+                  </div>
+                </div>
+
+                <!-- Trend Chart Section -->
+                <div class="trend-section mt-5">
+                  <h5 class="mb-3">
+                    {{
+                      "admin.reports.users-activities.activity-trends"
+                        | translate
+                    }}
